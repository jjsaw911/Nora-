# Copy to .env and fill in. Never commit the real .env (it is gitignored).

# --- Required ---
# OpenAI API key with access to the Realtime (gpt-realtime) models.
OPENAI_API_KEY=sk-...

# --- Optional: model + voice ---
# Realtime model name. e.g. gpt-realtime, gpt-realtime-2, gpt-4o-realtime-preview
NORA_REALTIME_MODEL=gpt-realtime
# Voice id. gpt-realtime voices: marin, cedar, alloy, ash, ballad, coral, echo, sage, shimmer, verse
NORA_VOICE=marin

# --- Optional: server bind (match your SSH tunnel, which forwards :8080) ---
NORA_HOST=0.0.0.0
NORA_PORT=8080

# --- Optional: let Nora text you (Twilio — same account covers SMS, WhatsApp, and Phase 2 calls) ---
# From the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Channel: "sms" (works instantly, any phone) or "whatsapp" (needs Meta/Twilio WhatsApp setup).
NORA_TEXT_CHANNEL=sms
# Sender: your Twilio number in E.164. For WhatsApp, your WhatsApp-enabled Twilio number
# (e.g. the sandbox number +14155238886 while testing).
NORA_TEXT_FROM=+1XXXXXXXXXX
# Recipient: your phone in E.164. On a trial account it must be a Twilio-verified number.
NORA_TEXT_TO=+1XXXXXXXXXX

# --- Optional: let Nora text you a safe-for-work selfie (local image generation) ---
# The image is generated ON THIS BOX by a local Stable Diffusion server, then sent as
# an MMS/WhatsApp attachment. Outfit + framing are locked safe-for-work in code.
#
# Image backend. Only "a1111" (Automatic1111, /sdapi/v1/txt2img) is implemented today.
# Launch A1111 with the API on: ./webui.sh --api  (add --medvram if VRAM is tight).
IMAGEGEN_BACKEND=a1111
# Where the image server listens, as seen FROM this box (localhost is normal).
IMAGEGEN_URL=http://127.0.0.1:7860
# Generation settings — keep small if you share the GPU with Llama (avoids CUDA OOM).
IMAGEGEN_STEPS=28
IMAGEGEN_CFG=6.5
IMAGEGEN_WIDTH=512
IMAGEGEN_HEIGHT=768
IMAGEGEN_SAMPLER=DPM++ 2M Karras
# Optional: force a specific checkpoint by name (as A1111 lists it). Blank = current.
IMAGEGEN_MODEL=
# Optional: seconds to wait for a slow/queued generation before giving up.
IMAGEGEN_TIMEOUT=180
# The persona's fixed look, so every selfie is the same (adult) person. Edit freely.
COMPANION_APPEARANCE=a friendly adult woman in her late twenties, shoulder-length brown hair, light makeup, warm genuine smile

# Delivery: Twilio (cloud) must fetch the image from a PUBLIC url — it cannot reach
# Tailscale/LAN. Point MEDIA_DIR at a folder your public web server serves, and set
# PUBLIC_MEDIA_BASE_URL to the matching public base (e.g. your Cloudflare tunnel).
# Note: SMS-MMS needs an MMS-capable Twilio number (US/CA); WhatsApp handles media too.
MEDIA_DIR=media
PUBLIC_MEDIA_BASE_URL=
