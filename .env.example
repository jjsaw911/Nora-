# Copy to .env and fill in. Never commit the real .env (it is gitignored).

# --- Required ---
# OpenAI API key with access to the Realtime (gpt-realtime) models.
OPENAI_API_KEY=sk-...

# --- Optional: model + voice ---
# Realtime model name. e.g. gpt-realtime, gpt-realtime-2, gpt-4o-realtime-preview
NORA_REALTIME_MODEL=gpt-realtime
# Voice id. gpt-realtime voices: marin, cedar, alloy, ash, ballad, coral, echo, sage, shimmer, verse
NORA_VOICE=marin

# --- Optional: server bind (match your SSH tunnel, which forwards :8080) ---
NORA_HOST=0.0.0.0
NORA_PORT=8080

# --- Optional: let Nora text you (Twilio — same account covers SMS, WhatsApp, and Phase 2 calls) ---
# From the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Channel: "sms" (works instantly, any phone) or "whatsapp" (needs Meta/Twilio WhatsApp setup).
NORA_TEXT_CHANNEL=sms
# Sender: your Twilio number in E.164. For WhatsApp, your WhatsApp-enabled Twilio number
# (e.g. the sandbox number +14155238886 while testing).
NORA_TEXT_FROM=+1XXXXXXXXXX
# Recipient: your phone in E.164. On a trial account it must be a Twilio-verified number.
NORA_TEXT_TO=+1XXXXXXXXXX
